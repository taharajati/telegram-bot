# Telegram Bot Token (required)
BOT_TOKEN=your_bot_token_here

# Admin IDs - comma-separated Telegram user IDs (required at least one)
ADMIN_IDS=123456789,987654321

# ─── Database ───────────────────────────────────────────
# PostgreSQL (production — via Docker Compose)
DATABASE_URL=postgresql+asyncpg://foroshgram:foroshgram_secure_2024@postgres:5432/foroshgram
# SQLite (local dev fallback — uncomment below)
# DATABASE_URL=sqlite+aiosqlite:///data/orders.db

# ─── Branding ───────────────────────────────────────────
STORE_NAME=فروشگرام

# ─── Payment (ZarinPal) ────────────────────────────────
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=

# ─── Subscription (Card-to-Card) ───────────────────────
# Card number for subscription payments (no spaces)
ADMIN_CARD_NUMBER=6219861937973138
# Card holder name
ADMIN_CARD_HOLDER=طه رجعتی
# Grace period in days after subscription expires before suspend
# (0 = instant suspend, 7 = 7 day grace)
SUBSCRIPTION_GRACE_DAYS=7

# ─── Telegram ───────────────────────────────────────────
# NOTIFICATION_CHANNEL_ID=-1001234567890
# PROXY_URL=http://user:pass@host:port
